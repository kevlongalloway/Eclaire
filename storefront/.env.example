# Base URL of the E-commaxxing API worker (no trailing slash).
# When unset, the app runs in DEMO MODE on the bundled mock catalog
# (products render, but checkout and discount codes are disabled).
VITE_API_BASE=https://your-worker.workers.dev

# The slug of the store this storefront represents (multi-store). Must match a
# store created in the admin Stores page. Sent to the API as X-Store-Slug so it
# scopes products, discounts, and checkout to that store. Leave blank to use the
# API's default store. Read at BUILD time — redeploy after changing it.
VITE_STORE_SLUG=

# Public base URL for product images — your R2 bucket's public URL (no trailing
# slash). Uploaded image references keep their R2 object key, so the storefront
# serves them directly from here. Read at BUILD time — redeploy after changing.
# When unset, images fall back to the API's /images/<key> route.
VITE_IMAGE_BASE=https://pub-4780839150d74b88a0f11c9e84dbdd90.r2.dev
